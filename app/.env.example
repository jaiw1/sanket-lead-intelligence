# Frontend build-time configuration. Copy to .env.local for a dev run; the nginx deploy
# passes these on the `vite build` command line. No secret ever belongs in this file:
# everything with a VITE_ prefix is compiled into the public bundle.

# Where the platform API lives, relative to the site origin. Defaults to /api/v1.
# Set it for the DEPLOYED build so a backend outage shows as "degraded", not as the
# static demo. Leave it UNSET for deploy/export_static.py's frozen fallback bundle,
# which is meant to detect the missing backend and switch to the bundled snapshot.
VITE_API_BASE=/api/v1

# Router basename, when it must differ from vite's --base. Normally unnecessary:
# build the deployed bundle with `vite build --base /sanket/` and this is derived.
# VITE_ROUTER_BASE=/sanket

# Dev-only: proxy /api to a local uvicorn so cookies stay same-origin and CSRF works.
# Defaults to http://127.0.0.1:8001 (vite.config.js), which is where the platform's
# README tells you to run it.
# VITE_DEV_API_PROXY=http://127.0.0.1:8001
